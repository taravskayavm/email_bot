#########################################
# ОБЯЗАТЕЛЬНО ЗАПОЛНИТЕ ПЕРЕД ЗАПУСКОМ #
#########################################
EMAIL_ADDRESS=your_mail@mail.ru              # реальный адрес на mail.ru
EMAIL_PASSWORD=app_specific_password         # пароль приложения (Mail.ru → Безопасность)
APPEND_TO_SENT=1                             # дублировать отправку в «Отправленные»
USE_SMTP_SESSIONS=0                          # 1 = переиспользовать одно SMTP-соединение
TELEGRAM_BOT_TOKEN=123456:ABCDEF-telegram    # токен от @BotFather

#########################################
# IMAP / SMTP
#########################################
IMAP_HOST=imap.mail.ru
IMAP_PORT=993
IMAP_TIMEOUT=15                              # таймаут соединения, секунд
IMAP_RETRIES=3                               # кол-во повторов при ошибках
IMAP_IPV4_ONLY=1                             # 1 = избегать IPv6 (актуально для VPN)
INBOX_MAILBOX=INBOX                          # папка входящих писем
SENT_MAILBOX=Отправленные                    # папка «Отправленные» (Mail.ru)
SMTP_HOST=smtp.mail.ru
SMTP_PORT=465                                # 465 (SSL) или 587 (STARTTLS)
SMTP_SSL=1                                   # 1 = SSL, 0 = STARTTLS
SMTP_TIMEOUT=45                              # таймаут в секундах
SMTP_MODE=auto                               # auto|ssl|starttls
SMTP_CONNECT_RETRIES=3                       # повторы при ошибке подключения
SMTP_CONNECT_BACKOFF=2                       # экспоненциальный бэкофф (секунд)
UNSUBSCRIBE_ALLOW_WITHOUT_TOKEN=0             # HTTP-отписка требует действительный токен
# UNSUBSCRIBE_PUBLIC_URL=https://mail.example.ru/unsubscribe

#########################################
# Ограничения отправки
#########################################
DAILY_SEND_LIMIT=200                         # суточный лимит рассылки
MAX_EMAILS_PER_DAY=300                       # лимит писем в день (бот)
COOLDOWN_DAYS=180                            # глобальный кулдаун перед повторной отправкой

# Окно молчания
EMAIL_LOOKBACK_DAYS=180
# Синхронизация истории перед отправкой: «не чаще, чем раз в N часов»
EMAIL_SYNC_INTERVAL_HOURS=24
# Путь к файлу состояния синхронизации
SYNC_STATE_PATH=var/sync_state.json
# Путь к логам производительности (опционально)
PERF_LOG_PATH=var/perf.log

#########################################
# Встраивание логотипа (если шаблон поддерживает)
#########################################
INLINE_LOGO=1

#########################################
# Уровень уведомлений Telegram-бота
#########################################
# full = прежнее поведение; brief = только старт/финиш; none = полная тишина
NOTIFY_LEVEL=brief

#########################################
# Ручная рассылка — правило 180 дней
#########################################
MANUAL_ENFORCE_180=1                        # 1 = применять правило; 0 = не применять
MANUAL_DAYS=180
MANUAL_ALLOW_OVERRIDE=1                     # 1 = показать кнопку «Отправить всем»

#########################################
# Диагностика (необязательные флаги)
#########################################
# DIAG_PING_SMTP=1
# DIAG_PING_IMAP=1
# SMTP_MODE=auto                            # auto|ssl|starttls (диагностика покажет активный)
# EMAIL_ROLE_PERSONAL_THRESHOLD=0.9
# HISTORY_DB_PATH=var/state.db              # переопределить путь к истории отправок

# Прогресс-статус при крауле (троттлинг обновлений)
# Максимум обновлений статуса в минуту. Значение 100 ≈ одно обновление каждые 0.6 сек.
PROGRESS_MAX_UPDATES_PER_MINUTE=100

# Авто-подбор разделов
# Сколько кандидатов разделов предлагать максимум
DISCOVERY_MAX_CANDIDATES=12

#########################################
# Расширяемый блок-лист (опционально)
#########################################
FILTER_SUPPORT=0                            # 1 = блокировать support@
FILTER_BLOCKLIST=help@x.com,alerts@news.io  # CSV-список адресов (или используйте файл blocked_emails.txt)

#########################################
# Stop-list / авто-отписка
#########################################
# Путь к файлу с отписавшимися/заблокированными адресами
# Если не задан, используется ./blocked_emails.txt
BLOCKED_LIST_PATH=blocked_emails.txt

#########################################
# География доменов / переключатель «иностранных»
#########################################
# Домашние TLD и явные домены-исключения (gmail.com уже включён)
LOCAL_TLDS=.ru,.рф,.su
LOCAL_DOMAINS_EXTRA=gmail.com,yandex.com,yahoo.com,outlook.com

# По умолчанию не включать иностранные в «к отправке»
ALLOW_FOREIGN_DEFAULT=0

# (опционально) путь для состояния UI
UI_STATE_PATH=var/ui_state.json

#########################################
# Краулер (глубокий парсинг сайта)
#########################################
# Максимум страниц на домен при глубоком скане
CRAWL_MAX_PAGES_PER_DOMAIN=50
# Ограничение по времени на один запуск скана (сек)
CRAWL_TIME_BUDGET_SECONDS=120
# Пауза между запросами к одному хосту (мс)
CRAWL_PER_HOST_DELAY_MS=500
# Кэш robots.txt и его TTL
ROBOTS_CACHE_PATH=var/robots_cache.json
ROBOTS_CACHE_TTL_SECONDS=86400
# Заголовок User-Agent при краулинге
CRAWL_USER_AGENT=EmailBotCrawler/1.0

#########################################
# Поведение санитайзера / нормализация адресов
#########################################
OBFUSCATION_ENABLE=1                        # включить деобфускацию адресов
CONFUSABLES_NORMALIZE=1                     # нормализовать «похожие» символы
IDNA_DOMAIN_NORMALIZE=1                     # приводить домены к IDNA (punycode)
STRICT_DOMAIN_VALIDATE=1                    # строгая проверка доменов
DROP_REASON_IN_AUDIT=1                      # писать причину дропа в аудит-лог
FOOTNOTES_MODE=smart
AGGRESSIVE_LOCAL_REPAIR=1
STRICT_LEFT_BOUNDARY=1                      # строгая левая граница при парсинге
SUSPECTS_REQUIRE_CONFIRM=1                  # требовать подтверждения для подозрительных
REPAIR_TLD_TAIL=1
PDF_JOIN_HYPHEN_BREAKS=1
PDF_JOIN_EMAIL_BREAKS=1

#########################################
# Ограничение на тип e-mail (роль и FIO)
#########################################
EMAIL_ROLE_PERSONAL_ONLY=1                  # 1 = пропускать только персональные адреса
EMAIL_ROLE_PERSONAL_THRESHOLD=0.9           # порог совпадения ФИО для персональных адресов

#########################################
# Отчёты / логи
#########################################
SEND_STATS_PATH=var/send_stats.jsonl
REPORT_TZ=Europe/Moscow

#########################################
# Bounce-сканер (fallback POP3, если IMAP недоступен)
#########################################
BOUNCE_FETCH_BACKEND=auto                   # auto|imap|pop3
POP3_HOST=pop.mail.ru
POP3_PORT=995
POP3_SSL=1
POP3_TIMEOUT=20
BOUNCE_SINCE_DAYS=7                         # глубина сканирования бонсов
BOUNCE_CHECK_INTERVAL_SECONDS=60           # проверка возвратов в фоне
BOUNCE_WATCH_SECONDS=604800                # обновлять итог рассылки при возвратах в течение 7 дней

# Повторы после временных сбоев доставки (soft-bounce)
SOFT_BOUNCE_RETRY_HOURS=48                  # через сколько часов пробовать снова
SOFT_BOUNCE_MAX_RETRIES=2                   # максимум повторных попыток
SOFT_BOUNCE_PATH=var/soft_bounces.jsonl     # путь к очереди soft-bounce

#########################################
# Парсинг e-mail (отладка)
#########################################
DEBUG_EMAIL_PARSE=0
DEBUG_EMAIL_PARSE_LOG=0
# DEBUG_EMAIL_PARSE_LOG_PATH=var/email_parse_debug.log

#########################################
# Подписи/шаблоны — «новый» режим для кодов направлений
#########################################
TEMPLATES_NEW_SIGNATURE=bioinformatics,geography,psychology

# Optional: prefer a known-working Telegram Bot API address when VPN DNS returns
# an unreachable endpoint. Current DNS answers remain available as fallbacks;
# TLS is still verified for api.telegram.org.
# TELEGRAM_API_IP=149.154.167.220
# Ordered list overrides TELEGRAM_API_IP; connection/TLS errors try each IP then DNS.
# Successful routes are preferred; each route has its own connection pool.
# getUpdates also retries read/write failures and HTTP 5xx on the next route.
# Other requests are not replayed after read/write failures or HTTP 5xx.
# TELEGRAM_API_IPS=149.154.167.220,149.154.166.110
# INVALID_SESSION_ID during TLS automatically retries with a dotted SNI name.
# CA validation remains enabled and the canonical api.telegram.org SAN is checked.
# Telegram network limits. Larger media downloads get their own read timeout.
TELEGRAM_CONNECT_TIMEOUT=20
TELEGRAM_READ_TIMEOUT=30
TELEGRAM_WRITE_TIMEOUT=30
TELEGRAM_POOL_TIMEOUT=20
TELEGRAM_MEDIA_READ_TIMEOUT=180
TELEGRAM_FILE_DOWNLOAD_ATTEMPTS=3
# Telegram access: empty allowlists deny every command in both entrypoints.
ALLOWED_USER_IDS=
# Optional one-time username bootstrap in a private chat (without @).
# Binding persists in var/authorized_users.json; keep this file across deployments.
ALLOWED_USERNAMES=
# Groups are denied unless listed here; an allowed user is still required.
ALLOWED_CHAT_IDS=
